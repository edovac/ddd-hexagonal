{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_commit_on_main.py 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_commit_on_main.py",
            "statusMessage": "Checking branch before commit..."
          }
        ]
      }
    ]
  }
}
